<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Post</title>
</head>

<body>
    <h1>ระบบ Admin: แก้ไขบทความ</h1>
    <hr>

    <form action="/admin/edit/<%= post.id %>" method="POST">
        <label>ชื่อบทความ:</label><br>
        <input type="text" name="title" value="<%= post.title %>" required><br><br>

        <label>เนื้อหาบทความ:</label><br>
        <textarea name="content" rows="6" cols="50" required><%= post.content %></textarea><br><br>

        <button type="submit">บันทึกการแก้ไข</button>
    </form>

    <br>
    <a href="/admin">ยกเลิกและกลับหน้า Admin</a>
</body>

</html>